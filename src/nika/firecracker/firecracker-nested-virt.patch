+/// MSRs an L1 hypervisor in the guest depends on. KVM lists them only when nested
+/// virtualization is enabled, and they can be read only while the guest CPUID exposes SVM or
+/// VMX, so vCPUs keep the ones they can read (see `KvmVcpu::configure_msrs_for_boot`).
+static NESTED_MSR_RANGES: &[MsrRange] = &[
+    // SVM: the host save area of the L1 hypervisor (VMRUN faults while it is 0) and the
+    // L2 TSC ratio.
+    MSR_RANGE!(MSR_VM_HSAVE_PA),
+    MSR_RANGE!(MSR_AMD64_TSC_RATIO),
+    // VMX: the capability MSRs KVM_SET_NESTED_STATE validates the L1 VMCS against.
+    MSR_RANGE!(MSR_IA32_VMX_BASIC, 18),
+];
+
+/// Whether `index` is an MSR of nested virtualization.
+pub fn msr_is_nested(index: u32) -> bool {
+    NESTED_MSR_RANGES.iter().any(|range| range.contains(index))
+}
