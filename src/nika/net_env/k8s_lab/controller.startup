. /lab-bootstrap.sh

# Configure Reachable IP Address
ip address add 201.1.1.2/24 dev eth0

# Wait for a default route (bridged eth1 may still be attaching).
echo "[startup] waiting for default route"
stage_wait "default route" 60 sh -c 'ip route show default | grep -q .'

# Prefer the lab default route (bridged eth1 may already have a Docker default).
# Bridging is required for host port publish of the API; this restores fabric egress.
ip route replace default via 201.1.1.1 dev eth0

# Signal the container entrypoint to exec k3s as PID1 (see issue #38).
mkdir -p /var/run
touch /var/run/net-ready
echo "[startup] net-ready; waiting for k3s API"

# Wait Kubernetes control plane startup
stage_wait "k3s API" 600 kubectl --request-timeout=5s get --raw=/readyz
echo "[startup] k3s API ready; waiting for host image preload"

# Wait for the host-side preload orchestrator to finish all k3s nodes.
stage_wait "host image preload" 900 test -f /var/run/images-preloaded

# Cluster add-ons (CoreDNS) run on the control plane, as in a typical k3s
# deployment, so cluster DNS has one well-known home.
stage_wait "coredns deployment" 300 kubectl --request-timeout=15s -n kube-system get deployment coredns
stage_run "place coredns on the control plane" kubectl --request-timeout=30s -n kube-system patch deployment coredns --type merge -p '{"spec":{"template":{"spec":{"nodeSelector":{"node-role.kubernetes.io/control-plane":"true"}}}}}'
stage_wait "coredns rollout" 300 kubectl --request-timeout=15s -n kube-system rollout status deployment/coredns --timeout=5s

# Start MetalLB
echo "[startup] applying MetalLB"
stage_run "apply /k8s/metallb-frr.yaml" kubectl --request-timeout=30s apply -f /k8s/metallb-frr.yaml

# Wait MetalLB controller startup
echo "[startup] waiting for MetalLB controller"
stage_ready "metallb-system component=controller" -n metallb-system --selector component=controller
echo "[startup] MetalLB controller ready"

# Apply MetalLB configuration
# The webhook serves shortly after the controller pod is Ready; retry until it admits.
stage_wait "apply /k8s/metallb-conf.yaml" 120 kubectl --request-timeout=30s apply -f /k8s/metallb-conf.yaml

# Wait MetalLB speakers startup
echo "[startup] waiting for MetalLB speakers"
stage_ready "metallb-system component=speaker" -n metallb-system --selector component=speaker
echo "[startup] MetalLB speakers ready"

# Start NGINX Ingress Controller
echo "[startup] applying ingress-nginx"
stage_run "apply /k8s/ingress-nginx.yaml" kubectl --request-timeout=30s apply -f /k8s/ingress-nginx.yaml

# Wait NGINX Ingress Controller startup
echo "[startup] waiting for ingress-nginx"
stage_ready "ingress-nginx app.kubernetes.io/component=controller" -n ingress-nginx --selector app.kubernetes.io/component=controller
echo "[startup] ingress-nginx ready"

# Apply PVs
stage_run "apply /k8s/pv.yaml" kubectl --request-timeout=30s apply -f /k8s/pv.yaml

# Apply sample workloads in dependency order (namespaces before deployments).
echo "[startup] applying sample workloads"
stage_run "apply /shared/ns.yaml" kubectl --request-timeout=30s apply -f /shared/ns.yaml
stage_run "apply /shared/pvc.yaml" kubectl --request-timeout=30s apply -f /shared/pvc.yaml
stage_run "apply /shared/deploy_db.yaml" kubectl --request-timeout=30s apply -f /shared/deploy_db.yaml

echo "[startup] waiting for databases"
stage_ready "word-ns app=worddb" -n word-ns -l app=worddb
stage_ready "weather-ns app=weatherdb" -n weather-ns -l app=weatherdb
echo "[startup] databases ready"

stage_run "apply /shared/deploy_app.yaml" kubectl --request-timeout=30s apply -f /shared/deploy_app.yaml
stage_run "apply /shared/svc.yaml" kubectl --request-timeout=30s apply -f /shared/svc.yaml
stage_run "apply /shared/ing.yaml" kubectl --request-timeout=30s apply -f /shared/ing.yaml

echo "[startup] waiting for sample apps"
stage_ready "word-ns app=word" -n word-ns -l app=word
stage_ready "weather-ns app=weather" -n weather-ns -l app=weather
# The images initialize their databases at process startup. Start one replica
# first so the initial schema/data writes do not race across two pods.
stage_run "scale replicas" kubectl --request-timeout=30s scale -n word-ns deployment/word-dply --replicas=2
stage_run "scale replicas" kubectl --request-timeout=30s scale -n weather-ns deployment/weather-dply --replicas=2
stage_wait "word-dply rollout" 300 kubectl --request-timeout=15s rollout status -n word-ns deployment/word-dply --timeout=5s
stage_wait "weather-dply rollout" 300 kubectl --request-timeout=15s rollout status -n weather-ns deployment/weather-dply --timeout=5s
echo "[startup] sample apps ready"

# Per-node monitoring agents call the sample apps through their Service names.
stage_run "apply /shared/uptime-agent.yaml" kubectl --request-timeout=30s apply -f /shared/uptime-agent.yaml
stage_wait "uptime-agent rollout" 300 kubectl --request-timeout=15s rollout status -n monitoring daemonset/uptime-agent --timeout=5s
# Bootstrap leaves transient Warning events (image pulls via the temporary mirror,
# rollouts, readiness during boot). A long-running cluster would have aged them out.
stage_run "clear bootstrap warning events" kubectl --request-timeout=30s delete events -A --field-selector type=Warning
touch /var/run/startup-complete
