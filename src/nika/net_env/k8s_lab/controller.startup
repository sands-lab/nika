. /nika-bootstrap.sh

# Configure Reachable IP Address
ip address add 201.1.1.2/24 dev eth0

# Wait for a default route (bridged eth1 may still be attaching).
echo "[nika-startup] waiting for default route"
nika_wait "default route" 60 sh -c 'ip route show default | grep -q .'

# Prefer the lab default route (bridged eth1 may already have a Docker default).
# Bridging is required for host port publish of the API; this restores fabric egress.
ip route replace default via 201.1.1.1 dev eth0

# Signal the container entrypoint to exec k3s as PID1 (see issue #38).
mkdir -p /var/run
touch /var/run/nika-net-ready
echo "[nika-startup] nika-net-ready; waiting for k3s API"

# Wait Kubernetes control plane startup
nika_wait "k3s API" 600 kubectl --request-timeout=5s get --raw=/readyz
echo "[nika-startup] k3s API ready; waiting for host image preload"

# Wait for the host-side preload orchestrator to finish all k3s nodes.
nika_wait "host image preload" 900 test -f /var/run/nika-images-preloaded

# Start MetalLB
echo "[nika-startup] applying MetalLB"
nika_run "apply /k8s/metallb-frr.yaml" kubectl --request-timeout=30s apply -f /k8s/metallb-frr.yaml

# Wait MetalLB controller startup
echo "[nika-startup] waiting for MetalLB controller"
nika_ready "metallb-system component=controller" -n metallb-system --selector component=controller
echo "[nika-startup] MetalLB controller ready"

# Apply MetalLB configuration
nika_run "apply /k8s/metallb-conf.yaml" kubectl --request-timeout=30s apply -f /k8s/metallb-conf.yaml

# Wait MetalLB speakers startup
echo "[nika-startup] waiting for MetalLB speakers"
nika_ready "metallb-system component=speaker" -n metallb-system --selector component=speaker
echo "[nika-startup] MetalLB speakers ready"

# Start NGINX Ingress Controller
echo "[nika-startup] applying ingress-nginx"
nika_run "apply /k8s/ingress-nginx.yaml" kubectl --request-timeout=30s apply -f /k8s/ingress-nginx.yaml

# Wait NGINX Ingress Controller startup
echo "[nika-startup] waiting for ingress-nginx"
nika_ready "ingress-nginx app.kubernetes.io/component=controller" -n ingress-nginx --selector app.kubernetes.io/component=controller
echo "[nika-startup] ingress-nginx ready"

# Apply PVs
nika_run "apply /k8s/pv.yaml" kubectl --request-timeout=30s apply -f /k8s/pv.yaml

# Apply sample workloads in dependency order (namespaces before deployments).
echo "[nika-startup] applying sample workloads"
nika_run "apply /shared/ns.yaml" kubectl --request-timeout=30s apply -f /shared/ns.yaml
nika_run "apply /shared/pvc.yaml" kubectl --request-timeout=30s apply -f /shared/pvc.yaml
nika_run "apply /shared/deploy_db.yaml" kubectl --request-timeout=30s apply -f /shared/deploy_db.yaml

echo "[nika-startup] waiting for databases"
nika_ready "word-ns app=worddb" -n word-ns -l app=worddb
nika_ready "weather-ns app=weatherdb" -n weather-ns -l app=weatherdb
echo "[nika-startup] databases ready"

nika_run "apply /shared/deploy_app.yaml" kubectl --request-timeout=30s apply -f /shared/deploy_app.yaml
nika_run "apply /shared/svc.yaml" kubectl --request-timeout=30s apply -f /shared/svc.yaml
nika_run "apply /shared/ing.yaml" kubectl --request-timeout=30s apply -f /shared/ing.yaml

echo "[nika-startup] waiting for sample apps"
nika_ready "word-ns app=word" -n word-ns -l app=word
nika_ready "weather-ns app=weather" -n weather-ns -l app=weather
# The images initialize their databases at process startup. Start one replica
# first so the initial schema/data writes do not race across two pods.
nika_run "scale replicas" kubectl --request-timeout=30s scale -n word-ns deployment/word-dply --replicas=2
nika_run "scale replicas" kubectl --request-timeout=30s scale -n weather-ns deployment/weather-dply --replicas=2
nika_wait "word-dply rollout" 300 kubectl --request-timeout=15s rollout status -n word-ns deployment/word-dply --timeout=5s
nika_wait "weather-dply rollout" 300 kubectl --request-timeout=15s rollout status -n weather-ns deployment/weather-dply --timeout=5s
echo "[nika-startup] sample apps ready"
touch /var/run/nika-startup-complete
