# topology documentation: https://containerlab.dev/lab-examples/min-clos/
name: __LAB_NAME__

mgmt:
  network: br-__LAB_NAME__
  ipv4-subnet: __MGMT_IPV4_SUBNET__
  ipv6-subnet: __MGMT_IPV6_SUBNET__

topology:
  kinds:
    nokia_srlinux:
      image: ghcr.io/nokia/srlinux:24.10
    linux:
      image: ghcr.io/hellt/network-multitool
  nodes:
    leaf1:
      kind: nokia_srlinux
      type: ixr-d2l
      mgmt-ipv4: __MGMT_IP_LEAF1__
      mgmt-ipv6: __MGMT_IPV6_LEAF1__
    leaf2:
      kind: nokia_srlinux
      type: ixr-d2l
      mgmt-ipv4: __MGMT_IP_LEAF2__
      mgmt-ipv6: __MGMT_IPV6_LEAF2__
    spine:
      kind: nokia_srlinux
      type: ixr-d3l
      mgmt-ipv4: __MGMT_IP_SPINE__
      mgmt-ipv6: __MGMT_IPV6_SPINE__
    client1:
      kind: linux
      mgmt-ipv4: __MGMT_IP_CLIENT1__
      mgmt-ipv6: __MGMT_IPV6_CLIENT1__
    client2:
      kind: linux
      mgmt-ipv4: __MGMT_IP_CLIENT2__
      mgmt-ipv6: __MGMT_IPV6_CLIENT2__

  links:
    - endpoints: ["leaf1:e1-1", "spine:e1-1"]
    - endpoints: ["leaf2:e1-1", "spine:e1-2"]
    - endpoints: ["client1:eth1", "leaf1:e1-2"]
    - endpoints: ["client2:eth1", "leaf2:e1-2"]
