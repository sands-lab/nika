FROM alpine:3.22@sha256:2e0b81d60597f449baa56dc25d355367869d2dca4cd57e866f1e2b52af3eb55f AS tools

# The k3s image has no libc, so the tools are copied with the musl loader and
# the shared libraries they link against.
RUN apk add --no-cache iperf3 python3 tcpdump && \
    mkdir -p /out && \
    stdlib="$(python3 -c 'import sysconfig; print(sysconfig.get_path("stdlib"))')" && \
    for bin in /usr/bin/iperf3 /usr/bin/python3 /usr/bin/tcpdump; do \
        cp -L --parents "$bin" /out && \
        ldd "$bin" | awk '/=>/ {print $3} !/=>/ {print $1}' | grep '^/' | \
            xargs -r -I{} cp -L --parents {} /out; \
    done && \
    for ext in "$stdlib"/lib-dynload/*.so; do \
        ldd "$ext" 2>/dev/null | awk '/=>/ {print $3}' | grep '^/' | \
            xargs -r -I{} cp -L --parents {} /out; \
    done && \
    cp -a --parents "$stdlib" /out && \
    rm -rf "/out$stdlib/test" "/out$stdlib/idlelib" "/out$stdlib/tkinter" \
        "/out$stdlib/ensurepip" && \
    find /out -name __pycache__ -prune -exec rm -rf {} +

FROM rancher/k3s:v1.34.1-k3s1@sha256:5e0707cfd1239b358ef73f3254bc3eadc027dd30cd5ec6ca41e29e47652a1b8c

# Diagnosis tools for k3s nodes: packet capture, throughput tests, and the
# python3 runtime used by active TCP probes.
COPY --from=tools /out/ /
