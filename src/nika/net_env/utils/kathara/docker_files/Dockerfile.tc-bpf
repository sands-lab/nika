FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

# clang and the kernel UAPI headers build the eBPF object next to tc.
RUN apt-get update && \
    apt-get install -y --no-install-recommends clang iproute2 libc6-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*
