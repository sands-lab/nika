# Multi-arch ONOS for Kathara: native runtime + official ONOS Java tree.
# Upstream onosproject/onos is linux/amd64-only (Zulu amd64 JVM). We copy only
# the arch-independent /root/onos distribution and run it on a host-arch JRE
# so Kathara accepts the image on Linux arm64 (no foreign-arch rejection).
#
# Requires BuildKit (DOCKER_BUILDKIT=1) for cross-stage COPY from linux/amd64.
ARG ONOS_IMAGE=onosproject/onos:2.7-latest@sha256:ee324bcf56ed01497069143f83f1315fcf634b36f1ac3c589a8c54ccaf354813
ARG ONOS_PLATFORM=linux/amd64

FROM --platform=$ONOS_PLATFORM ${ONOS_IMAGE} AS onos-dist

# Multi-arch OpenJDK 11 (amd64 + arm64); copy into Kathara base below.
FROM eclipse-temurin:11-jre-jammy AS jre

FROM kathara/base:latest

RUN apt-get update && \
    apt-get install -y --no-install-recommends iproute2 iputils-ping curl nftables && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=jre /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"
# Newer JDK 11 rejects some ONOS/Karaf JAR ZIP extra fields; keep this even when
# lab meta overrides JAVA_OPTS (e.g. -Xmx1536m).
ENV JDK_JAVA_OPTIONS="-Djdk.util.zip.disableZip64ExtraFieldValidation=true"

COPY --from=onos-dist /root/onos /root/onos

# The onos-thirdparty-base boot feature bundles two native-code fragments that
# only ship x86_64/win32/macos (netty-tcnative-boringssl-static) or 32-bit arm
# (sigar) variants: neither has an aarch64 build. On an arm64 host JRE, Karaf's
# FeaturesServiceImpl fails to resolve them and aborts the *entire* boot
# feature sequence before onos-api/onos-core/onos-rest are even attempted, so
# ONOS never comes up (not merely missing metrics/TLS accel). Both bundles are
# optional at runtime (sigar backs system-metrics collection; boringssl backs
# a native TLS accelerator for Atomix's Netty transport, which falls back to
# the JDK provider), so drop them from the feature descriptor on arm64 hosts
# only, leaving amd64 behavior unchanged.
ARG TARGETARCH
RUN set -eux; \
    if [ "${TARGETARCH}" != "amd64" ]; then \
      features_xml="$(find /root/onos -name 'onos-features-*-features.xml' -print -quit)"; \
      test -n "${features_xml}"; \
      sed -i \
        -e '/<bundle>mvn:io\.netty\/netty-tcnative-boringssl-static\//d' \
        -e '/<bundle>mvn:org\.knowhowlab\.osgi\/sigar\//d' \
        "${features_xml}"; \
    fi

WORKDIR /root/onos

COPY onos-entrypoint.sh /nika/onos-entrypoint.sh
RUN chmod +x /nika/onos-entrypoint.sh

ENTRYPOINT ["/nika/onos-entrypoint.sh"]
