# Credentials only. Operational settings: config/nika.yaml
# Usage: README.md | src/agent/README.md | `nika config show`
# CLI flags override config/nika.yaml when both are set.
#
# Uncomment only the provider(s) you use — empty values can look "configured".

# =============================================================================
# Model provider credentials
# =============================================================================

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# Custom / self-hosted OpenAI-compatible API key (optional; omit if unauthenticated).
# Base URL and model belong in config/nika.yaml as agent.base_url and agent.model.
# NIKA_CUSTOM_API_KEY=

# =============================================================================
# Agent sandbox (optional)
# =============================================================================
# Required when nika.sandbox.backend is e2b in config/nika.yaml: the key of
# an E2B-compatible service.
# E2B_API_KEY=
# Optional: the domain of a self-hosted E2B (API at api.<domain>). Used when
# nika.sandbox.url is null.
# E2B_DOMAIN=
# Optional: a Claude subscription for Claude agents instead of
# ANTHROPIC_API_KEY, created with `claude setup-token`. A ChatGPT subscription for Codex uses a
# login instead; see docs/operations/agent-sandbox.md#subscriptions.
# CLAUDE_CODE_OAUTH_TOKEN=

# =============================================================================
# Hugging Face (leaderboard trajectories submit)
# =============================================================================
# Write token for nika-bench/nika-trajectories (or a fork you can PR to).
# HF_TOKEN=
